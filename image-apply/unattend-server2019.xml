<?xml version="1.0" encoding="utf-8"?>
<!--
  windows-auto-build-pipeline: offline-dropped unattend.xml for the specialize/oobeSystem
  passes only. Windows Server 2019 variant of unattend-server2022.xml - same proven structure,
  only the driver path (2k19 instead of 2k22) and ComputerName differ. Unlike the 2022/2025/
  Windows 11 templates (each transcribed from a live PHASE2_ENGINEERING_LOG.md bring-up
  session), this file was produced during Phase B design work
  (WINDOWS_SERVER_2019_IMPLEMENTATION_PLAN.md), not a live session - log filenames below use a
  "server2019" prefix rather than a fabricated "sessionNN" number for that reason. See
  unattend-server2025.xml's own header comment for the full rationale behind this file's
  structure (why PnpCustomizationsNonWinPE isn't used, why pnputil runs live via
  FirstLogonCommands instead, etc.) - not repeated here.

  Order 4's WinRM-enable step deliberately does NOT call Enable-PSRemoting (PHASE3_ENGINEERING_
  LOG.md, 2026-09-02 Phase E1): its internal Register-PSSessionConfiguration step is a documented
  WinRM StopPending hang trigger (PowerShell/JEA GitHub issue #30) - and this project's own
  pywinrm usage (run_cmd/run_ps) only ever needs the plain WinRS shell resource, never a
  registered PSSession endpoint, so nothing is actually lost by skipping it. Set-Service WinRM
  -StartupType Automatic replaces the one thing Enable-PSRemoting would otherwise have covered
  that this step still needs (every other step - listener, auth, firewall - was already explicit
  here regardless).

  Order 3's network-category step deliberately has NO wait-loop (PHASE3_ENGINEERING_LOG.md,
  2026-09-02 Phase E1, same session): `Get-NetIPAddress | Where-Object {...}` hangs indefinitely
  when run via FirstLogonCommands on Server 2019 specifically - isolated across 7 successive
  diagnostic boots via dev/run-server2019-specialize-test.sh (Get-NetIPAddress alone works fine;
  Get/Set-NetConnectionProfile both work fine; the pipe into Where-Object is what hangs). DHCP is
  fast/reliable in this environment (confirmed directly via ipconfig), and Order 4's own
  New-NetFirewallRule has no -Profile restriction, so the wait was defensive, never load-bearing -
  removing it entirely is lower-risk than trying to fix or work around the hanging pipe. Order 4
  originally also removed/recreated the WSMan listener via `Get-ChildItem WSMan:\localhost\
  Listener | Remove-Item ...; New-Item -Path WSMan:\localhost\Listener ...` - this pipe hung too
  (same diagnostic session), so it was dropped: Server 2019 already ships with a default listener
  active (confirmed - WinRM responds before FirstLogonCommands ever runs), so this step now just
  reconfigures it in place via `winrm set` (an external-process invocation, not a native
  cmdlet pipe) rather than deleting and recreating it. NOTE for
  future editors of this file: keep every <Description> here terse (one short clause) - a verbose
  Description caused Windows Setup's own answer-file parser to reject the entire file as invalid
  ("Windows could not parse or process the unattend answer file... for pass [specialize]"), a
  failure mode this project hit twice before catching it - xmllint's well-formedness check does
  NOT catch this, only Windows Setup's own stricter schema validation does.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <ComputerName>WIN2019-DESIGN</ComputerName>
      <TimeZone>UTC</TimeZone>
      <RegisteredOwner>Windows Lab</RegisteredOwner>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <NetworkLocation>Work</NetworkLocation>
        <ProtectYourPC>3</ProtectYourPC>
        <SkipUserOOBE>true</SkipUserOOBE>
        <SkipMachineOOBE>true</SkipMachineOOBE>
      </OOBE>
      <UserAccounts>
        <AdministratorPassword>
          <Value>TestP@ssw0rd123</Value>
          <PlainText>true</PlainText>
        </AdministratorPassword>
      </UserAccounts>
      <AutoLogon>
        <Enabled>true</Enabled>
        <LogonCount>5</LogonCount>
        <Username>Administrator</Username>
        <Password>
          <Value>TestP@ssw0rd123</Value>
          <PlainText>true</PlainText>
        </Password>
      </AutoLogon>
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <RequiresUserInput>false</RequiresUserInput>
          <Description>Install NetKVM network driver live (pnputil) - DriverDatabase alone only PCI-matches it, not full NDIS class install; see Finding 39/40</Description>
          <CommandLine>cmd.exe /c pnputil /add-driver C:\Drivers\NetKVM\2k19\amd64\netkvm.inf /install &gt; C:\server2019-pnputil-log.txt 2&gt;&amp;1</CommandLine>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>2</Order>
          <RequiresUserInput>false</RequiresUserInput>
          <Description>Log progress marker</Description>
          <CommandLine>cmd.exe /c echo firstlogon-reached &gt; C:\server2019-firstlogon-marker.txt</CommandLine>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>3</Order>
          <RequiresUserInput>false</RequiresUserInput>
          <Description>Set network category to Private (no wait-loop - see this file's own header comment)</Description>
          <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Get-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private *&gt;&gt; C:\server2019-netcat-log.txt"</CommandLine>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>4</Order>
          <RequiresUserInput>false</RequiresUserInput>
          <Description>Enable WinRM over HTTP (no Enable-PSRemoting, no pipe, no service restart - see header)</Description>
          <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Set-Service WinRM -StartupType Automatic; winrm set winrm/config/service/auth '@{Basic=\"true\"}'; winrm set winrm/config/service '@{AllowUnencrypted=\"true\"}'; winrm set winrm/config/client '@{TrustedHosts=\"*\"}'; New-NetFirewallRule -DisplayName 'WinRM-HTTP' -Direction Inbound -Protocol TCP -LocalPort 5985 -Action Allow -ErrorAction SilentlyContinue *&gt;&gt; C:\server2019-winrm-log.txt"</CommandLine>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>
  </settings>
</unattend>
