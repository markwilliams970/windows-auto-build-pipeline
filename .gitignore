# Build artifacts - large disk images and firmware var files, regenerated by the
# pipeline on every real run, never source. See CLAUDE.md's "Ephemeral
# Infrastructure, Still" principle - nothing here is meant to be long-lived.
image-apply/output/

# Phase 3 dev fast-iteration harness output (disposable COW overlays +
# per-run efivars scratch copies) - the harness config itself (dev/*.pkr.hcl,
# dev/*.sh, dev/services-*.yaml) is real source and stays tracked.
dev/output/

# Production build output (provisioned VM artifacts + per-run efivars scratch
# copies from packer/boot-and-provision.pkr.hcl) - same ephemeral-infrastructure
# principle as image-apply/output/ above; packer/boot-and-provision.pkr.hcl
# itself is real source and stays tracked.
packer/output/

# ISO cache lives at ../iso_cache/ - one level above this repo, shared with
# ../windows-server-vm-automation/, not inside this repo's tree at all. No
# ignore rule needed here for it (nothing under this repo's iso_cache/ exists
# anymore); see CLAUDE.md's "Relationship to ../windows-server-vm-automation/".

# External tool dependencies - fetched via the clone step documented in
# PREREQUISITES.md, not vendored into this repo. BCD-SYS in particular carries
# its own nested .git, which git submodule tooling should own if this ever
# needs pinning, not a plain commit here.
tools/vendor/

# Claude Code local, machine-specific settings and runtime state - not shared
# project config (a future .claude/settings.json, if one is added, is shared
# config and should be tracked; these specific files are not).
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Python bytecode cache, regenerated automatically by any interpreter run
# against tools/*.py - never source.
__pycache__/
*.pyc

# windows-pipeline (Phase 5 CLI) packaging/build artifacts - matching
# ../windows11-lab's own .gitignore for the identical setuptools layout.
*.egg-info/
.venv/
build/
dist/
.pytest_cache/
